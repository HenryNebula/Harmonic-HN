# Copy to .envrc and adjust for your machine. .envrc is gitignored on purpose:
# it contains machine-specific paths that must not be shared.
export UV_CACHE_DIR=/path/to/cache/uv-cache
export UV_PROJECT_ENVIRONMENT=/path/to/venvs/harmonic-translation-server

